# Configuración de Supabase (OPCIONAL).
# Copia este archivo a `.env` y rellena tus valores. `.env` está en .gitignore (no se comitea).
# Sin estas variables, la app opera en modo LOCAL/OFFLINE (isSupabaseConfigured() = false).

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
