{
  "openapi": "3.0.3",
  "info": {
    "title": "Hu-Manos Colombia — API pública de necesidades",
    "description": "API REST pública de solo lectura para consultar necesidades u ofertas de ayuda de la comunidad en Colombia. Basada en Supabase / PostgREST.",
    "version": "1.0.0",
    "contact": {
      "name": "Hu-Manos Colombia",
      "url": "https://github.com/AndresEstebanPatino/hu-manos-colombia"
    }
  },
  "servers": [
    {
      "url": "https://xrxuzvvvorxukyoeqibg.supabase.co/rest/v1",
      "description": "Servidor REST principal de Supabase"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api_necesidades": {
      "get": {
        "summary": "Obtener lista de necesidades u ofertas de ayuda",
        "description": "Consulta registros públicos de la vista `api_necesidades`. Soporta filtros PostgREST mediante query parameters.",
        "operationId": "getApiNecesidades",
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "required": false,
            "description": "Columnas a retornar separadas por coma (ej. `id,titulo,ubicacion`). Si se omite, retorna todas las columnas.",
            "schema": {
              "type": "string",
              "default": "*"
            },
            "example": "id,titulo,ubicacion,categoria"
          },
          {
            "name": "modo",
            "in": "query",
            "required": false,
            "description": "Filtra por el modo de la necesidad (`eq.SOLICITUD` o `eq.OFERTA`).",
            "schema": {
              "type": "string",
              "enum": [
                "eq.SOLICITUD",
                "eq.OFERTA"
              ]
            },
            "example": "eq.OFERTA"
          },
          {
            "name": "completado",
            "in": "query",
            "required": false,
            "description": "Filtra por estado de cumplimiento (`eq.false` o `eq.true`).",
            "schema": {
              "type": "string",
              "enum": [
                "eq.false",
                "eq.true"
              ]
            },
            "example": "eq.false"
          },
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "description": "Filtra por categoría (ej. `eq.ALIMENTOS`, `eq.SALUD`, `eq.REFUGIO`, `eq.ROPA_COBIJAS`, `eq.MANO_DE_OBRA`, `eq.BEBES_LACTANCIA`, `eq.OTRO`).",
            "schema": {
              "type": "string"
            },
            "example": "eq.ALIMENTOS"
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "description": "Filtra por tipo de requerimiento (`eq.RECURSO`, `eq.VOLUNTARIO`, `eq.DINERO`, `eq.ESPECIE`).",
            "schema": {
              "type": "string"
            },
            "example": "eq.RECURSO"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Número máximo de registros a retornar.",
            "schema": {
              "type": "integer"
            },
            "example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Número de registros a omitir para paginación.",
            "schema": {
              "type": "integer"
            },
            "example": 0
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Ordenamiento de resultados (ej. `creado_en.desc`).",
            "schema": {
              "type": "string"
            },
            "example": "creado_en.desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa con la lista de necesidades u ofertas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiNecesidad"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetro de consulta inválido."
          },
          "401": {
            "description": "Header `apikey` ausente o no válido."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Llave pública anon de Supabase requerida para autenticar las solicitudes HTTP."
      }
    },
    "schemas": {
      "ApiNecesidad": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único de la necesidad (UUID o texto)."
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de necesidad (ej. RECURSO, VOLUNTARIO, DINERO, ESPECIE)."
          },
          "modo": {
            "type": "string",
            "description": "Modo de la publicación (SOLICITUD u OFERTA)."
          },
          "categoria": {
            "type": "string",
            "description": "Categoría asignada (ej. ALIMENTOS, SALUD, REFUGIO, ROPA_COBIJAS, MANO_DE_OBRA, BEBES_LACTANCIA, OTRO)."
          },
          "titulo": {
            "type": "string",
            "description": "Título descriptivo de la solicitud u oferta."
          },
          "descripcion": {
            "type": "string",
            "description": "Detalles completos y contexto."
          },
          "ubicacion": {
            "type": "string",
            "description": "Ubicación en texto plano (ej. ciudad o municipio)."
          },
          "latitud": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Coordenada de latitud GPS."
          },
          "longitud": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Coordenada de longitud GPS."
          },
          "meta_cantidad": {
            "type": "number",
            "description": "Cantidad meta objetiva requerida u ofrecida."
          },
          "progreso_actual": {
            "type": "number",
            "description": "Cantidad acumulada o alcanzada hasta la fecha."
          },
          "unidad_medida": {
            "type": "string",
            "description": "Unidad de medida (ej. unidades, kg, COP, personas)."
          },
          "completado": {
            "type": "boolean",
            "description": "Estado de la publicación (true si está completada)."
          },
          "imagen_url": {
            "type": "string",
            "nullable": true,
            "description": "URL pública de la imagen almacenada en Supabase Storage (opcional)."
          },
          "creado_en": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de creación en formato ISO 8601 UTC."
          }
        }
      }
    }
  }
}
