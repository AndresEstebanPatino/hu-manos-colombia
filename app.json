{
  "expo": {
    "name": "Hu-Manos Colombia",
    "slug": "hu-mano-colombia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hu-mano-colombia",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.humano.colombia"
    },
    "android": {
      "package": "co.humano.colombia"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hu-Manos usa tu ubicación para autocompletar dónde se busca o se vio a la persona."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
